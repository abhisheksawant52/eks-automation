# Copy to .env and adjust. All variables are optional; defaults are shown.
# Never commit real credentials — use the standard AWS credential chain.

# AWS region for all operations
EKS_AWS_REGION=us-east-1

# Optional named AWS profile (from ~/.aws/credentials); leave blank to use the
# default credential chain (env vars, shared config, or an instance/role).
EKS_AWS_PROFILE=

# Default cluster name used by CLI commands
EKS_CLUSTER_NAME=eks-automation-cluster

# Target Kubernetes version
EKS_KUBERNETES_VERSION=1.30

# Managed node group defaults (instance types are comma-separated)
EKS_NODE_INSTANCE_TYPES=t3.medium
EKS_NODE_MIN_SIZE=1
EKS_NODE_MAX_SIZE=10
EKS_NODE_DESIRED_SIZE=2
EKS_NODE_AMI_TYPE=AL2023_x86_64_STANDARD

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
EKS_LOG_LEVEL=INFO
